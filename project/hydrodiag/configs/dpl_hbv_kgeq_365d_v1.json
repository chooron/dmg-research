{
  "_protocol": "dpl_hbv_kgeq_window_ablation_v1",
  "_note": "HBV KGE(Q) pilot: 365-day warmup + 365-day prediction windows; direct end-to-end DPL without IC-parameter supervision.",

  "data_npz": "/home/jingxin/code/dmg-research/data/camels_dataset_petv2.npz",
  "gage_ids_path": "/home/jingxin/code/dmg-research/data/gage_id.npy",
  "dates_path": "/home/jingxin/code/dmg-research/data/camels_dates.npy",
  "data_pkl_dataset": "/home/jingxin/code/dmg-research/data/camels_dataset",
  "data_basin_ids": "/home/jingxin/code/dmg-research/project/benchmark/data/559sub_id.txt",
  "output_dir": "outputs/dpl_hbv_kgeq_365d_v1",

  "time_periods": {
    "warmup": {"start": "1988-01-02", "end": "1988-12-31", "days": 365},
    "calibration": {"start": "1989-01-01", "end": "1998-12-31", "days": 3652},
    "evaluation": {"start": "1999-01-01", "end": "2009-12-31", "days": 4018}
  },

  "window": {
    "warmup_days": 365,
    "prediction_days": 365,
    "stride_days": 365,
    "drop_incomplete_tail": true
