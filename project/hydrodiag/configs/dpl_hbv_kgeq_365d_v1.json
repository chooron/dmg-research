  "training": {
    "epochs": 100,
    "batch_size": 128,
    "optimizer": "AdamW",
    "lr": 0.01,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "scheduler": "cosine",
    "min_lr": 0.0001,
    "seed": 42,
    "validation_interval": 10
  },

  "runtime": {
    "device": "cuda",
    "forward_dtype": "float32",
    "final_metric_dtype": "float64"
  }
}
