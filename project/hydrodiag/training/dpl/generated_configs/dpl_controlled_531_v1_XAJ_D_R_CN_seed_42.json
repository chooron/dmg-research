{
  "_protocol": "dpl_camels_531_flexmopex_period_v1",
  "_note": "Controlled dissertation variant D_R (XAJ_D_R_CN): CN fixed structure + native XAJ 3-layer ET (xaj_c active) + single linear subsurface response (KSS/tau0 active). Reuses the canonical CN+XAJ dPL protocol exactly (dpl_camels_531_lite_v2 XAJ_CN seed_42); parameter specs from the frozen IC-verified controlled specs.",
  "data_source": "camels_dataset_pickle",
  "gage_ids_path": "/autodl-fs/data/gage_id.npy",
  "dates_path": "/autodl-fs/data/camels_dates.npy",
  "data_pkl_dataset": "/autodl-fs/data/camels_dataset",
  "data_basin_ids": "/autodl-fs/data/531sub_id.txt",
  "allow_evaluation_gap": true,
  "output_dir": "/autodl-fs/data/dmg_hydro_structure_diagnosis/dpl_controlled_531_v1/XAJ_D_R_CN/seed_42",
  "time_periods": {
    "warmup": {
      "start": "1980-10-01",
      "end": "1981-09-30",
      "days": 365
    },
    "calibration": {
      "start": "1981-10-01",
      "end": "1995-09-30",
      "days": 5113
    },
    "evaluation": {
      "start": "1995-10-01",
      "end": "2010-09-30",
      "days": 5479
    }
  },
  "window": {
    "warmup_days": 365,
    "prediction_days": 365,
    "stride_days": 365,
    "drop_incomplete_tail": true
  },
  "sampling": {
    "strategy": "balanced_valid_kge_windows",
    "min_valid_points": 30,
    "min_observation_std": 0.05,
    "note": "Sample basins uniformly, then sample only informative calibration windows within each basin."
  },
  "network": {
    "hidden_size": 256,
    "hidden_sizes": [
      256,
      256,
      256
    ],
    "depth": 3,
    "dropout": 0.05,
    "activation": "SiLU",
    "normalization": "robust_median_iqr_clip5",
    "output_epsilon": 0.0001,
    "initialization": "physical_parameter_defaults",
    "parameter_mapping": "sigmoid_to_physical_range_linear_v1"
  },
  "training": {
    "epochs": 100,
    "batch_size": 128,
    "optimizer": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "scheduler": "cosine",
    "min_lr": 0.0001,
    "seed": 42,
    "validation_interval": 10,
    "checkpoint_interval": 10
  },
  "runtime": {
    "device": "cuda",
    "forward_dtype": "float32",
    "final_metric_dtype": "float64"
  }
}