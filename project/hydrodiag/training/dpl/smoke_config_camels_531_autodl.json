  "training": {
    "epochs": 1,
    "batch_size": 2,
    "optimizer": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "scheduler": "cosine",
    "min_lr": 0.0001,
    "seed": 42,
    "validation_interval": 1
  },
  "runtime": {
    "device": "cuda",
    "forward_dtype": "float32",
    "final_metric_dtype": "float64"
  }
}
