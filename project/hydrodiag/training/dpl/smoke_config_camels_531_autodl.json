{
  "_protocol": "dpl_camels_531_flexmopex_smoke_v1",
  "_note": "AutoDL smoke configuration. Invoke --max-basins 2 --max-windows 1 --epochs 1; architecture matches the mature XAJ dPL configuration.",
  "data_source": "camels_dataset_pickle",
  "gage_ids_path": "/autodl-fs/data/gage_id.npy",
  "dates_path": "/autodl-fs/data/camels_dates.npy",
  "data_pkl_dataset": "/autodl-fs/data/camels_dataset",
  "data_basin_ids": "/autodl-fs/data/531sub_id.txt",
  "allow_evaluation_gap": true,
  "output_dir": "/autodl-fs/data/dmg_hydro_structure_diagnosis/dpl_camels_531_smoke",
  "time_periods": {
    "warmup": {"start": "1980-10-01", "end": "1981-09-30", "days": 365},
    "calibration": {"start": "1981-10-01", "end": "1995-09-30", "days": 5113},
    "evaluation": {"start": "1995-10-01", "end": "2010-09-30", "days": 5479}
  },
  "window": {
    "warmup_days": 365,
    "prediction_days": 365,
    "stride_days": 365,
    "drop_incomplete_tail": true
